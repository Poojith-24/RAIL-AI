# ==============================================================================
# RailAI: Real Railway / IRCTC API Configuration
# ==============================================================================

# Data Source Mode:
# Set to "LIVE" to query real live Indian Railway / IRCTC reservation data.
# When set to "DEMO" or when keys are absent, fallback demo data is used.
DATA_SOURCE_MODE="LIVE"

# Railway Data Provider Endpoint & API Key:
# Enter your authorized IRCTC partner or RapidAPI Indian Railways endpoint.
# Examples of supported live providers:
#   - RapidAPI Indian Railways (e.g. irctc1.p.rapidapi.com or indianrailapi.com)
#   - Authorized CRIS / IRCTC Enterprise Gateway Partner
RAILWAY_API_BASE_URL="https://irctc1.p.rapidapi.com"
RAILWAY_API_KEY=""

# Optional Secondary Header (for RapidAPI hosts like "irctc1.p.rapidapi.com")
RAILWAY_API_HOST="irctc1.p.rapidapi.com"

# Server Port
PORT=3000

# Security & Admin Authentication Secret
JWT_SECRET="railpredict-secure-admin-secret-key-2026"

